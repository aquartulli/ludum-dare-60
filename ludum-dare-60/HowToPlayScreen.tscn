theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 24
text = "GOAL
Your are the Falcon Mainframe. Your job is to execute the programs given to you. Just fetch an instruction and execute it!

FETCHING
The instruction module allows you to fetch instructions. Set the program counter to the instruction you want to fetch and press the FETCH button. Then read the punch card to decode the instruction. Each row of the punch card is one character, and the punch cards are read from top to bottom."
autowrap_mode = 3

